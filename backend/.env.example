APP_NAME="E-commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Si sirves el proyecto desde XAMPP (htdocs/ecommerce), usa la URL con el
# subpath /public. Si usas `php artisan serve`, usa http://127.0.0.1:8000
APP_URL=http://localhost/ecommerce/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos MySQL/MariaDB -------------------------------------------
# Con XAMPP, el puerto por defecto suele ser 3306. Si tienes otro MySQL
# instalado en tu sistema (p. ej. el "MySQL80" de Windows) ocupando el 3306,
# el de XAMPP puede correr en otro puerto (revisa xampp/mysql/bin/my.ini).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Autenticación JWT (tymon/jwt-auth) -------------------------------------
# Genera este valor con: php artisan jwt:secret
JWT_SECRET=
# Minutos de vigencia del token de acceso (60 = 1 hora)
JWT_TTL=60
# Minutos durante los que un token expirado aún puede refrescarse (14 días)
JWT_REFRESH_TTL=20160

# --- Stripe (pasarela de pago) ----------------------------------------------
# Crea una cuenta gratuita en https://dashboard.stripe.com/register y usa las
# claves de TEST (modo prueba) del panel: Developers > API keys.
# STRIPE_KEY es la clave pública (pk_test_...), usada solo por el frontend.
# STRIPE_SECRET es la clave secreta (sk_test_...), usada por esta API.
STRIPE_KEY=
STRIPE_SECRET=
# Firma del webhook: Developers > Webhooks > tu endpoint > "Signing secret"
# (whsec_...). Con el Stripe CLI en local: `stripe listen --forward-to
# http://127.0.0.1:8000/api/stripe/webhook` imprime este valor.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
