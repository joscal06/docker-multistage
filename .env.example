# =============================================================================
# Variables del ecosistema Voltio (docker compose las lee de ".env")
#
#   cp .env.example .env          # y luego completa los valores
#   ./scripts/generar-env.sh      # o genera .env con claves aleatorias
#
# El archivo .env NUNCA se sube al repositorio ni entra a las imágenes: los
# valores se inyectan a los contenedores en tiempo de ejecución.
# =============================================================================

# --- Puertos publicados en el host ------------------------------------------
# Frontend Next.js → http://localhost:3000
FRONTEND_PORT=3000
# API Laravel a través de Nginx → http://localhost:8000 (Swagger en /api/documentation)
API_PORT=8000

# --- Base de datos (servicio db, imagen oficial mysql:8.0) ------------------
# Clave del usuario root de MySQL. Solo la usa el contenedor db.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
# Base de datos que se crea al iniciar el volumen por primera vez
MYSQL_DATABASE=ecommerce_api
# Usuario sin privilegios de administrador con el que se conecta Laravel
MYSQL_USER=voltio
MYSQL_PASSWORD=cambia-esta-clave

# --- API Laravel (servicio api) ----------------------------------------------
# Clave de cifrado de Laravel (formato base64:...). Generar con:
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Secreto para firmar los JWT (tymon/jwt-auth). Generar con:
#   openssl rand -base64 48
JWT_SECRET=
# Minutos de vigencia del token JWT
JWT_TTL=60
# URL pública de la API (enlaces absolutos y Swagger)
API_PUBLIC_URL=http://localhost:8000
# Nivel de log de Laravel (los logs salen por stderr: docker compose logs api)
LOG_LEVEL=info
# true = carga el cliente demo y los 20 productos de ProductSeeder en cada
# arranque (es idempotente: no duplica registros)
SEED_DATABASE=true

# --- Stripe (opcional, modo de prueba) ---------------------------------------
# Sin estas llaves todo funciona menos el pago. Deben ser de la misma cuenta.
# Llave publicable pk_test_... (la usa el frontend; se incrusta en el build)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_KEY=
# Llave secreta sk_test_... (solo la usa la API, nunca el frontend)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Frontend Next.js (servicio frontend) ------------------------------------
# URL pública del frontend (canonical y Open Graph)
SITE_URL=http://localhost:3000
